# Frontend Environment Variables
# Copy this file to .env.local for local development overrides

# Backend Service Configuration
VITE_BACKEND_HOST=localhost
VITE_BACKEND_HTTP_PORT=3000
VITE_BACKEND_WS_PORT=3001

# Application Environment
VITE_APP_ENVIRONMENT=development

# Feature Flags (optional)
VITE_ENABLE_DEBUG_PANEL=true
VITE_ENABLE_PERFORMANCE_MONITOR=true

# Uneeq Configuration (optional - can override config.yaml)
# VITE_UNEEQ_CDN_URL=https://cdn-eu.uneeq.io/hosted-experience/deploy/index.js
# VITE_UNEEQ_API_URL=https://api-eu.uneeq.io